---
import '@fontsource-variable/golos-text';
import '@fontsource-variable/literata/opsz.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { SectionKey } from '../data/site';

interface Props {
  title: string;
  description: string;
  current?: SectionKey;
  progress?: boolean;
}

const { title, description, current, progress } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title="Заметки — Анисин Алексей" href="/rss.xml">
</head>
<body>
  <SiteHeader current={current} progress={progress} />
  <main>
    <slot />
  </main>
  <SiteFooter />
</body>
</html>
