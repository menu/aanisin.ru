---
// Типографика тела заметки. Стили висят только на прямых потомках,
// чтобы не протекать внутрь MDX-компонентов (Callout, Faq и т. д.)
---
<div class="prose"><slot /></div>

<style>
  .prose { max-width: 720px; }
  .prose > :global(*) { max-width: 62ch; }
  .prose > :global(:first-child) { margin-top: 0; }

  .prose > :global(p) { margin: 18px 0 0; font-family: var(--serif); font-size: 18px; line-height: 1.65; color: var(--text); text-wrap: pretty; }
  .prose > :global(h2 + p) { margin-top: 20px; }
  .prose > :global(h3 + p) { margin-top: 12px; }

  .prose > :global(h2) {
    margin: 46px 0 0;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    font-size: 32px;
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: -.025em;
    scroll-margin-top: 110px;
  }
  .prose > :global(h3) { margin: 28px 0 0; font-size: 22px; line-height: 1.2; font-weight: 700; letter-spacing: -.02em; }

  /* Ссылки живут не только в абзацах: в статьях они есть в таблицах и списках */
  .prose > :global(p a:not([data-footnote-ref])),
  .prose > :global(ul a),
  .prose > :global(ol a),
  .prose > :global(table a) { color: #0A62B0; box-shadow: inset 0 -1px 0 rgba(10, 98, 176, .4); }
  .prose > :global(p a:not([data-footnote-ref]):hover),
  .prose > :global(ul a:hover),
  .prose > :global(ol a:hover),
  .prose > :global(table a:hover) { color: #084E8C; box-shadow: inset 0 -1px 0 #084E8C; }
  .prose :global(sup) { font-size: 12px; line-height: 0; }

  .prose :global(code) { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85em; background: var(--sand); padding: 1px 5px; }

  /* Нумерованный список с жирным началом пункта */
  .prose > :global(ol) { margin: 20px 0 0; padding: 0; list-style: none; counter-reset: item; display: flex; flex-direction: column; gap: 14px; font-size: 16px; line-height: 1.5; color: var(--text-2); }
  .prose > :global(ol > li) { display: flex; gap: 14px; counter-increment: item; }
  .prose > :global(ol > li::before) { content: counter(item); flex: none; font-size: 14px; color: var(--muted); padding-top: 2px; }
  .prose > :global(ol strong) { font-weight: 600; color: var(--ink); }

  /* Маркированный список — та же сетка, что у нумерованного */
  .prose > :global(ul) { margin: 20px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 16px; line-height: 1.5; color: var(--text-2); }
  .prose > :global(ul > li) { display: flex; gap: 14px; }
  .prose > :global(ul > li::before) { content: '—'; flex: none; color: var(--muted); }
  .prose > :global(ul strong) { font-weight: 600; color: var(--ink); }

  /* Таблицы: шире колонки текста — в них бывает по четыре-пять столбцов */
  .prose > :global(table) { margin: 22px 0 0; width: 100%; max-width: none; border-collapse: collapse; font-size: 16px; }
  .prose > :global(table th) { padding: 0 20px 9px 0; border-bottom: 1px solid var(--ink); text-align: left; font-size: 11px; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); }
  .prose > :global(table td) { padding: 12px 20px 12px 0; border-bottom: 1px solid var(--line); vertical-align: top; color: var(--text-2); }
  .prose > :global(table td strong) { font-weight: 600; color: var(--ink); }
  .prose > :global(table tr:hover td) { background: #F9F8F5; }

  /* На узком экране широкая таблица прокручивается вбок, а не сжимается в столбик букв */
  @media (max-width: 700px) {
    .prose > :global(table) { display: block; width: auto; overflow-x: auto; }
    .prose > :global(table th), .prose > :global(table td) { min-width: 150px; }
  }

  /* Сноски (GFM) */
  .prose > :global(.footnotes) { margin-top: 36px; padding-top: 16px; border-top: 1px solid var(--line); }
  .prose > :global(.footnotes ol) { margin: 0; padding: 0; list-style: none; counter-reset: fn; display: flex; flex-direction: column; gap: 8px; }
  .prose > :global(.footnotes li) { display: flex; gap: 12px; counter-increment: fn; font-size: 13.5px; line-height: 1.55; color: var(--muted); scroll-margin-top: 110px; }
  .prose > :global(.footnotes li::before) { content: counter(fn); flex: none; }
  .prose > :global(.footnotes p) { margin: 0; }
  .prose > :global(.footnotes a) { color: var(--muted); }
</style>
