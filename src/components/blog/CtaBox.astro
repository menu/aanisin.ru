---
import MailBlock from '../MailBlock.astro';

interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---
<section class="container wrap">
  <div class="box">
    <div class="text">
      <h2 class="h2 title">{title}</h2>
      <p class="p">{text}</p>
    </div>
    <MailBlock label="Почта" />
  </div>
</section>

<style>
  .wrap { margin: 76px 0; }
  .box { background: var(--sand); padding: 44px clamp(22px, 4vw, 40px); display: flex; flex-wrap: wrap; gap: 24px 60px; justify-content: space-between; align-items: flex-end; }
  .text { flex: 1 1 380px; min-width: 0; }
  .title { max-width: 20ch; text-wrap: balance; }
  .p { margin-top: 14px; font-size: 17px; line-height: 1.5; color: var(--text-2); max-width: 44ch; text-wrap: pretty; }
</style>
