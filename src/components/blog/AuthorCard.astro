---
import { site } from '../../data/site';
---
<div class="card">
  <img src="/photo.jpg" width="56" height="56" alt="" class="photo">
  <div class="body">
    <div class="name">Алексей Анисин</div>
    <p class="text">SEO-специалист с 2017&nbsp;года. Крупные каталоги и сайты услуг: аудит, семантика, структура. Сейчас беру консультации.</p>
    <a href={`mailto:${site.email}`} class="cta">Написать&#8202;❱</a>
  </div>
</div>

<style>
  .card { margin-top: 26px; max-width: 62ch; background: var(--sand); padding: 22px 24px; display: flex; flex-wrap: wrap; gap: 18px; align-items: flex-start; }
  .photo { width: 56px; height: 56px; flex: none; object-fit: cover; display: block; }
  .body { flex: 1 1 260px; min-width: 0; }
  .name { font-size: 17px; font-weight: 600; }
  .text { margin-top: 7px; font-size: 15.5px; line-height: 1.5; color: var(--text-2); max-width: 46ch; text-wrap: pretty; }
  .cta { display: inline-block; margin-top: 12px; font-size: 15px; font-weight: 500; color: var(--accent); }
  .cta:hover { color: var(--accent-hover); }
</style>
