---
import { site } from '../data/site';

interface Props {
  num: number;
  title: string;
  desc: string;
  featured?: boolean;
}

const { num, title, desc, featured = false } = Astro.props;
---
<li class:list={['service', { featured }]}>
  <span class="num">{String(num).padStart(2, '0')}</span>
  <h3 class="title">{title}</h3>
  <span class="desc">{desc}</span>
  {featured
    ? <a href={`mailto:${site.email}`} class="cta">Написать&#8202;❱</a>
    : <span class="badge">Сейчас не беру</span>}
</li>

<style>
  .service {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--line-2);
  }
  .featured { padding: 22px 16px; margin: 0 -16px; border-bottom-color: var(--ink); background: var(--paper); }
  .num { flex: none; width: 32px; font-size: 11px; font-weight: 600; letter-spacing: .07em; color: var(--muted); }
  .title { flex: 0 1 260px; min-width: 0; font-size: 22px; line-height: 1.2; font-weight: 700; letter-spacing: -.02em; }
  .desc { flex: 1 1 300px; min-width: 0; font-size: 16px; line-height: 1.5; color: var(--text-2); }
  .badge { flex: none; margin-left: auto; font-size: 13.5px; font-weight: 600; color: var(--muted); background: var(--chip); padding: 5px 10px; white-space: nowrap; }
  .cta { flex: none; margin-left: auto; font-size: 15px; font-weight: 500; color: var(--accent); white-space: nowrap; }
  .cta:hover { color: var(--accent-hover); }
</style>
