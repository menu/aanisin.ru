---
import Placeholder from './Placeholder.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  category: string;
  date: string;
  title: string;
  description: string;
  // Обложка заметки. Без неё — штриховка, как в Placeholder
  cover?: ImageMetadata;
  // home — описание антиквой, как на главной; compact — гротеском, как в «Ещё по теме»
  variant?: 'home' | 'compact';
}

const { href, category, date, title, description, cover, variant = 'home' } = Astro.props;
---
<a href={href} class:list={['note', variant]}>
  {cover
    ? <Image src={cover} alt="" widths={[360, 540, 720]} sizes="(max-width: 640px) 100vw, 360px" class="cover" />
    : <Placeholder />}
  <div class="meta"><span class="tag">{category}</span><span>{date}</span></div>
  <h3 class="title">{title}</h3>
  <p class:list={['desc', { serif: variant === 'home' }]}>{description}</p>
</a>

<style>
  .note { display: block; min-width: 0; color: var(--ink); }
  .note:hover { color: var(--ink); opacity: .82; }
  .cover { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .meta { margin-top: 12px; display: flex; gap: 10px; align-items: center; font-size: 13.5px; color: var(--muted); }
  .tag { background: var(--sand); padding: 3px 9px; font-weight: 600; color: var(--ink); }
  .title { margin-top: 9px; font-size: 19px; line-height: 1.3; font-weight: 700; letter-spacing: -.015em; }
  .home .desc { margin-top: 8px; font-size: 15.5px; line-height: 1.55; color: var(--text); max-width: 38ch; }
  .compact .desc { margin-top: 7px; font-size: 15px; line-height: 1.5; color: var(--text-2); }
</style>
