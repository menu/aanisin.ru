---
import { site } from '../data/site';

interface Props {
  label: string;
}

const { label } = Astro.props;
---
<div class="mail-block">
  <div class="eyebrow">{label}</div>
  <a href={`mailto:${site.email}`}>{site.email}</a>
</div>

<style>
  .mail-block { flex: 0 1 auto; }
  a {
    display: inline-block;
    margin-top: 7px;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -.02em;
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  a:hover { color: var(--ink); box-shadow: inset 0 -2px 0 var(--ink); }
</style>
