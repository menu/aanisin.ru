---
import { site } from '../data/site';
---
<footer class="site-footer">
  <div class="container inner">
    <div class="head">{site.name}</div>
    <div class="about">SEO‑специалист.<br>Москва.</div>
    <div class="bottom">© 2026</div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #FFFFFF; }
  .inner { padding-top: 44px; padding-bottom: 48px; }
  .head { padding-bottom: 16px; border-bottom: 1px solid rgba(255, 255, 255, .16); font-size: 16px; font-weight: 700; }
  .about { margin-top: 26px; font-size: 14px; line-height: 1.5; color: #A8A49E; }
  .bottom { margin-top: 40px; padding-top: 16px; border-top: 1px solid rgba(255, 255, 255, .16); font-size: 13.5px; color: #847F79; }
</style>
